# Required outside local development - generate a long random value
SECRET_KEY=change-me-to-a-long-random-string

# Database - SQLite by default for local runs, PostgreSQL in docker-compose
DATABASE_URL=sqlite:///./secureauth.db
# DATABASE_URL=postgresql://secureauth:secureauth@localhost:5432/secureauth

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
